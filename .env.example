# Copy to .env to override defaults, or let .\setup.ps1 write .env for you. Every setting is optional.
# .env is not committed.

# Where the demo database lives. Keep it outside the repository: the cockpit refuses the
# repository's own data folder. A relative path is read from the repository root.
VELOXA_DATA_DIR=..\veloxa-demo-data
VELOXA_DB_FILENAME=cockpit.db

# Web server
VELOXA_HOST=127.0.0.1
VELOXA_PORT=8010

# DEBUG, INFO, WARNING, ERROR
VELOXA_LOG_LEVEL=INFO

# The LLM is optional. With it off, everything runs offline with no API key.
VELOXA_LLM_ENABLED=false

# The folder that holds Day1_Mon_16Nov ... Day4_Thu_19Nov (read only; used by .\setup-demo-data.ps1).
# VELOXA_SOURCE_PACK=
