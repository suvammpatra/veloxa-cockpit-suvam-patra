# Copy to .env to override defaults. Every setting is optional.

# Where the SQLite database lives (created on first start).
VELOXA_DATA_DIR=data
VELOXA_DB_FILENAME=cockpit.db

# Web server
VELOXA_HOST=127.0.0.1
VELOXA_PORT=8000

# DEBUG, INFO, WARNING, ERROR
VELOXA_LOG_LEVEL=INFO

# The LLM is optional. With it off, everything runs offline with no API key.
VELOXA_LLM_ENABLED=false
